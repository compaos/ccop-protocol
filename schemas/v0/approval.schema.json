{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ccop.dev/schemas/v0.5.3/approval.schema.json",
  "title": "Approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ccop",
    "object",
    "payload"
  ],
  "properties": {
    "ccop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "const": "0.5.3"
        },
        "critical_extensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "issuer",
        "revision",
        "created_at"
      ],
      "properties": {
        "type": {
          "const": "approval"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "issuer": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "const": 1
        },
        "created_at": {
          "$ref": "https://ccop.dev/schemas/v0.5.3/shared/timestamp.schema.json"
        },
        "updated_at": {
          "$ref": "https://ccop.dev/schemas/v0.5.3/shared/timestamp.schema.json"
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval"
      ],
      "properties": {
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "effect_ref",
            "effect_hash",
            "status",
            "requested_from",
            "max_leases"
          ],
          "properties": {
            "effect_ref": {
              "$ref": "https://ccop.dev/schemas/v0.5.3/shared/object-ref.schema.json"
            },
            "effect_hash": {
              "$ref": "https://ccop.dev/schemas/v0.5.3/shared/semantic-hash.schema.json"
            },
            "requested_from": {
              "$ref": "https://ccop.dev/schemas/v0.5.3/shared/principal-ref.schema.json"
            },
            "approved_by": {
              "$ref": "https://ccop.dev/schemas/v0.5.3/shared/principal-ref.schema.json"
            },
            "status": {
              "enum": [
                "PENDING",
                "APPROVED",
                "DENIED",
                "EXPIRED",
                "REVOKED"
              ]
            },
            "issued_at": {
              "$ref": "https://ccop.dev/schemas/v0.5.3/shared/timestamp.schema.json"
            },
            "expires_at": {
              "$ref": "https://ccop.dev/schemas/v0.5.3/shared/timestamp.schema.json"
            },
            "max_leases": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  }
}
