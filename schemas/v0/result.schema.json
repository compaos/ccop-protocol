{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ccop.dev/schemas/v0.5.3/result.schema.json",
  "title": "Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ccop",
    "object",
    "payload"
  ],
  "properties": {
    "ccop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "const": "0.5.3"
        },
        "critical_extensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "issuer",
        "revision",
        "created_at"
      ],
      "properties": {
        "type": {
          "const": "result"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "issuer": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "const": 1
        },
        "created_at": {
          "$ref": "https://ccop.dev/schemas/v0.5.3/shared/timestamp.schema.json"
        },
        "updated_at": {
          "$ref": "https://ccop.dev/schemas/v0.5.3/shared/timestamp.schema.json"
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result"
      ],
      "properties": {
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_ref",
            "status"
          ],
          "properties": {
            "run_ref": {
              "$ref": "https://ccop.dev/schemas/v0.5.3/shared/object-ref.schema.json"
            },
            "status": {
              "enum": [
                "SUCCESS",
                "FAILURE",
                "PARTIAL"
              ]
            },
            "outputs": {
              "type": "object"
            },
            "costs": {
              "type": "array",
              "items": {
                "$ref": "https://ccop.dev/schemas/v0.5.3/shared/cost.schema.json"
              }
            },
            "evidence_candidate_refs": {
              "type": "array",
              "items": {
                "$ref": "https://ccop.dev/schemas/v0.5.3/shared/object-ref.schema.json"
              }
            }
          }
        }
      }
    }
  }
}
