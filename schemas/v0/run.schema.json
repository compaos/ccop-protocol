{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ccop.dev/schemas/v0.5.3/run.schema.json",
  "title": "Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ccop",
    "object",
    "payload"
  ],
  "properties": {
    "ccop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "const": "0.5.3"
        },
        "critical_extensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "issuer",
        "revision",
        "created_at"
      ],
      "properties": {
        "type": {
          "const": "run"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "issuer": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "created_at": {
          "$ref": "https://ccop.dev/schemas/v0.5.3/shared/timestamp.schema.json"
        },
        "updated_at": {
          "$ref": "https://ccop.dev/schemas/v0.5.3/shared/timestamp.schema.json"
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run"
      ],
      "properties": {
        "run": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "task_ref",
            "execution_engine_ref",
            "state",
            "started_at"
          ],
          "properties": {
            "task_ref": {
              "$ref": "https://ccop.dev/schemas/v0.5.3/shared/object-ref.schema.json"
            },
            "execution_engine_ref": {
              "$ref": "https://ccop.dev/schemas/v0.5.3/shared/object-ref.schema.json"
            },
            "state": {
              "enum": [
                "QUEUED",
                "RUNNING",
                "WAITING_AUTHORITY",
                "WAITING_DECISION",
                "PAUSED",
                "CANCELLING",
                "SUCCEEDED",
                "FAILED",
                "DENIED",
                "CANCELLED",
                "TIMED_OUT"
              ]
            },
            "started_at": {
              "$ref": "https://ccop.dev/schemas/v0.5.3/shared/timestamp.schema.json"
            },
            "ended_at": {
              "$ref": "https://ccop.dev/schemas/v0.5.3/shared/timestamp.schema.json"
            },
            "terminal_reason": {
              "enum": [
                "EXECUTION_TIMEOUT",
                "QUEUE_TIMEOUT",
                "PAUSE_TIMEOUT",
                "CANCELLATION_TIMEOUT",
                "AUTHORITY_DENIED",
                "TECHNICAL_FAILURE"
              ]
            },
            "costs": {
              "type": "array",
              "items": {
                "$ref": "https://ccop.dev/schemas/v0.5.3/shared/cost.schema.json"
              }
            }
          }
        }
      }
    }
  }
}
