{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ccop.dev/schemas/v0.5.3/shared/money.schema.json",
  "title": "Money",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "amount",
    "scale",
    "currency"
  ],
  "properties": {
    "amount": {
      "$ref": "https://ccop.dev/schemas/v0.5.3/shared/decimal.schema.json"
    },
    "scale": {
      "type": "integer",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "minLength": 1
    }
  }
}
