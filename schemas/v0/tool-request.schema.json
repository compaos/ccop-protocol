{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ccop.dev/schemas/v0.5.3/tool_request.schema.json",
  "title": "ToolRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ccop",
    "object",
    "payload"
  ],
  "properties": {
    "ccop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "const": "0.5.3"
        },
        "critical_extensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "issuer",
        "revision",
        "created_at"
      ],
      "properties": {
        "type": {
          "const": "tool_request"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "issuer": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "const": 1
        },
        "created_at": {
          "$ref": "https://ccop.dev/schemas/v0.5.3/shared/timestamp.schema.json"
        },
        "updated_at": {
          "$ref": "https://ccop.dev/schemas/v0.5.3/shared/timestamp.schema.json"
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_request"
      ],
      "properties": {
        "tool_request": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_ref",
            "tool_ref",
            "tool_operation_id",
            "input"
          ],
          "properties": {
            "run_ref": {
              "$ref": "https://ccop.dev/schemas/v0.5.3/shared/object-ref.schema.json"
            },
            "tool_ref": {
              "$ref": "https://ccop.dev/schemas/v0.5.3/shared/tool-ref.schema.json"
            },
            "tool_operation_id": {
              "type": "string"
            },
            "input": {}
          }
        }
      }
    }
  }
}
