{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ccop.dev/schemas/v0.5.3/verification_spec.schema.json",
  "title": "VerificationSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ccop",
    "object",
    "payload"
  ],
  "properties": {
    "ccop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "const": "0.5.3"
        },
        "critical_extensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "issuer",
        "revision",
        "created_at"
      ],
      "properties": {
        "type": {
          "const": "verification_spec"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "issuer": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "created_at": {
          "$ref": "https://ccop.dev/schemas/v0.5.3/shared/timestamp.schema.json"
        },
        "updated_at": {
          "$ref": "https://ccop.dev/schemas/v0.5.3/shared/timestamp.schema.json"
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verification_spec"
      ],
      "properties": {
        "verification_spec": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "checks"
          ],
          "properties": {
            "task_ref": {
              "$ref": "https://ccop.dev/schemas/v0.5.3/shared/object-ref.schema.json"
            },
            "checks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "acceptance_criterion_ref",
                  "evidence_selector",
                  "assertion"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "acceptance_criterion_ref": {
                    "type": "string"
                  },
                  "evidence_selector": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "evidence_type",
                      "cardinality"
                    ],
                    "properties": {
                      "evidence_type": {
                        "type": "string"
                      },
                      "cardinality": {
                        "enum": [
                          "one",
                          "all"
                        ]
                      }
                    }
                  },
                  "evidence_window": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "anchor"
                    ],
                    "properties": {
                      "anchor": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "type"
                        ],
                        "properties": {
                          "type": {
                            "enum": [
                              "absolute",
                              "verification_started_at",
                              "task_execution_completed_at",
                              "run_ended_at",
                              "operation_ended_at"
                            ]
                          },
                          "run_ref": {
                            "$ref": "https://ccop.dev/schemas/v0.5.3/shared/object-ref.schema.json"
                          },
                          "operation_ref": {
                            "$ref": "https://ccop.dev/schemas/v0.5.3/shared/object-ref.schema.json"
                          },
                          "start_at": {
                            "$ref": "https://ccop.dev/schemas/v0.5.3/shared/timestamp.schema.json"
                          },
                          "end_at": {
                            "$ref": "https://ccop.dev/schemas/v0.5.3/shared/timestamp.schema.json"
                          }
                        }
                      },
                      "lookback_seconds": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  },
                  "assertion_window": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "duration_seconds",
                      "aggregation"
                    ],
                    "properties": {
                      "duration_seconds": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "aggregation": {
                        "const": "ALL"
                      }
                    }
                  },
                  "assertion": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "operator"
                    ],
                    "properties": {
                      "path": {
                        "$ref": "https://ccop.dev/schemas/v0.5.3/shared/json-pointer.schema.json"
                      },
                      "operator": {
                        "enum": [
                          "eq",
                          "neq",
                          "gt",
                          "gte",
                          "lt",
                          "lte",
                          "decimal_eq",
                          "decimal_neq",
                          "decimal_gt",
                          "decimal_gte",
                          "decimal_lt",
                          "decimal_lte"
                        ]
                      },
                      "expected": {}
                    }
                  },
                  "independence": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "required"
                    ],
                    "properties": {
                      "required": {
                        "type": "boolean"
                      },
                      "closure_scope": {
                        "enum": [
                          "direct_control",
                          "full_closure"
                        ]
                      },
                      "shared_ancestor_allowlist": {
                        "type": "array",
                        "items": {
                          "$ref": "https://ccop.dev/schemas/v0.5.3/shared/principal-ref.schema.json"
                        }
                      }
                    }
                  }
                }
              }
            },
            "max_attempts": {
              "type": "integer",
              "minimum": 1
            },
            "verification_deadline": {
              "$ref": "https://ccop.dev/schemas/v0.5.3/shared/timestamp.schema.json"
            }
          }
        }
      }
    }
  }
}
